{
  "name": "@schematichq/schematic-components",
  "version": "3.0.0",
  "main": "dist/schematic-components.cjs.js",
  "module": "dist/schematic-components.esm.js",
  "types": "dist/schematic-components.d.ts",
  "browser": {
    "./dist/schematic-components.cjs.js": "./dist/schematic-components.browser.cjs.js",
    "./dist/schematic-components.esm.js": "./dist/schematic-components.browser.esm.js"
  },
  "exports": {
    ".": {
      "types": "./dist/schematic-components.d.ts",
      "browser": {
        "import": "./dist/schematic-components.browser.esm.js",
        "require": "./dist/schematic-components.browser.cjs.js"
      },
      "import": "./dist/schematic-components.esm.js",
      "require": "./dist/schematic-components.cjs.js",
      "default": "./dist/schematic-components.esm.js"
    },
    "./v3": {
      "types": "./dist/schematic-components-v3.d.ts",
      "import": "./dist/schematic-components-v3.esm.js",
      "require": "./dist/schematic-components-v3.cjs.js",
      "default": "./dist/schematic-components-v3.esm.js"
    },
    "./v3/locales/en.json": "./dist/locales/en.json",
    "./v3/fixtures": {
      "types": "./dist/schematic-components-v3-fixtures.d.ts",
      "import": "./dist/schematic-components-v3-fixtures.esm.js",
      "require": "./dist/schematic-components-v3-fixtures.cjs.js",
      "default": "./dist/schematic-components-v3-fixtures.esm.js"
    }
  },
  "files": [
    "dist/schematic-components.cjs.js",
    "dist/schematic-components.esm.js",
    "dist/schematic-components.browser.cjs.js",
    "dist/schematic-components.browser.esm.js",
    "dist/schematic-components.d.ts",
    "dist/schematic-components-v3.cjs.js",
    "dist/schematic-components-v3.esm.js",
    "dist/schematic-components-v3.d.ts",
    "dist/schematic-components-v3-fixtures.cjs.js",
    "dist/schematic-components-v3-fixtures.esm.js",
    "dist/schematic-components-v3-fixtures.d.ts",
    "dist/locales/en.json"
  ],
  "author": "Schematic <engineering@schematichq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SchematicHQ/schematic-js.git"
  },
  "scripts": {
    "dev": "pnpm run dev:browser:esm",
    "dev:cjs": "node esbuild.mjs --format=cjs --variant=server --watch",
    "dev:esm": "node esbuild.mjs --format=esm --variant=server --watch",
    "dev:v3": "node esbuild.mjs --format=esm --entry=v3 --watch",
    "dev:browser:esm": "node esbuild.mjs --format=esm --variant=browser --watch",
    "build": "pnpm run tsc && pnpm run openapi && pnpm run format && pnpm run lint && pnpm run clean && pnpm run build:cjs && pnpm run build:esm && pnpm run build:browser:cjs && pnpm run build:browser:esm && pnpm run build:v3:cjs && pnpm run build:v3:esm && pnpm run build:v3:fixtures:cjs && pnpm run build:v3:fixtures:esm && pnpm run build:v3:locales && pnpm run build:types",
    "build:cjs": "node esbuild.mjs --format=cjs --variant=server",
    "build:esm": "node esbuild.mjs --format=esm --variant=server",
    "build:browser:cjs": "node esbuild.mjs --format=cjs --variant=browser",
    "build:browser:esm": "node esbuild.mjs --format=esm --variant=browser",
    "build:v3:cjs": "node esbuild.mjs --format=cjs --entry=v3",
    "build:v3:esm": "node esbuild.mjs --format=esm --entry=v3",
    "build:v3:fixtures:cjs": "node esbuild.mjs --format=cjs --entry=v3-fixtures",
    "build:v3:fixtures:esm": "node esbuild.mjs --format=esm --entry=v3-fixtures",
    "build:v3:locales": "mkdir -p dist/locales && cp src/v3/locales/en.json dist/locales/en.json",
    "build:types": "pnpm exec tsc && pnpm exec api-extractor run && pnpm exec api-extractor run -c api-extractor-v3.json && pnpm exec api-extractor run -c api-extractor-v3-fixtures.json",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint src",
    "openapi": "./generate_openapi.sh -c ./src/api/config_checkoutexternal.yml && ./generate_openapi.sh -c ./src/api/config_componentspublic.yml",
    "test": "./test.sh",
    "test:watch": "vitest",
    "tsc": "pnpm exec tsc",
    "test:demo": "../scripts/test-components.sh",
    "test:v3": "./test.sh src/v3",
    "v3:locales": "node scripts/write-locales.mjs"
  },
  "dependencies": {
    "@schematichq/schematic-icons": "^0.8.0",
    "@stripe/stripe-js": "^9.14.0",
    "i18next": "^26.4.0",
    "lodash": "^4.18.1",
    "pako": "^3.0.1",
    "react-i18next": "16.1.6",
    "styled-components": "^6.5.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@microsoft/api-extractor": "^7.59.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@schematichq/schematic-js": "workspace:^",
    "@schematichq/schematic-react": "workspace:^",
    "@stripe/react-stripe-js": "^6.8.2",
    "@swc/core": "^1.16.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.25",
    "@types/pako": "^3.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser": "^4.1.11",
    "csstype": "^3.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@stripe/react-stripe-js": ">=3",
    "react": ">=18",
    "react-dom": ">=18",
    "@schematichq/schematic-react": "workspace:^"
  },
  "msw": {
    "workerDirectory": [
      "",
      "src/test"
    ]
  }
}
