{
  "name": "@schematichq/schematic-angular",
  "version": "1.5.0",
  "author": "Schematic <engineering@schematichq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SchematicHQ/schematic-js.git"
  },
  "scripts": {
    "build": "./version.sh && pnpm run format && pnpm run lint && ng-packagr -p ng-package.json",
    "build:watch": "ng-packagr -p ng-package.json --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src --ext ts --report-unused-disable-directives --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@schematichq/schematic-js": "^1.5.0"
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "rxjs": ">=7.0.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
