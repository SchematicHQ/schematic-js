{
  "name": "@schematichq/schematic-vue",
  "version": "1.5.0",
  "main": "dist/schematic-vue.cjs.js",
  "module": "dist/schematic-vue.esm.js",
  "types": "dist/schematic-vue.d.ts",
  "files": [
    "dist/schematic-vue.cjs.js",
    "dist/schematic-vue.esm.js",
    "dist/schematic-vue.d.ts"
  ],
  "author": "Schematic <engineering@schematichq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SchematicHQ/schematic-js.git"
  },
  "scripts": {
    "dev": "pnpm exec tsc --watch",
    "build": "./version.sh && pnpm run tsc && pnpm run format && pnpm run lint && pnpm run clean && pnpm run build:cjs && pnpm run build:esm && pnpm run build:types",
    "build:cjs": "pnpm exec esbuild src/index.ts --bundle --external:vue --format=cjs --outfile=dist/schematic-vue.cjs.js",
    "build:esm": "pnpm exec esbuild src/index.ts --bundle --external:vue --format=esm --outfile=dist/schematic-vue.esm.js",
    "build:types": "pnpm exec tsc && pnpm exec api-extractor run",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src --ext ts --report-unused-disable-directives --fix",
    "test": "jest --config jest.config.js",
    "tsc": "pnpm exec tsc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@schematichq/schematic-js": "^1.5.0",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@vue/test-utils": "^2.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.0",
    "jest-esbuild": "^0.4.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
