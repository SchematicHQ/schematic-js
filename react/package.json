{
  "name": "@schematichq/schematic-react",
  "version": "1.6.0",
  "main": "dist/schematic-react.cjs.js",
  "module": "dist/schematic-react.esm.js",
  "types": "dist/schematic-react.d.ts",
  "files": [
    "dist/schematic-react.cjs.js",
    "dist/schematic-react.esm.js",
    "dist/schematic-react.d.ts"
  ],
  "author": "Schematic <engineering@schematichq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SchematicHQ/schematic-js.git"
  },
  "scripts": {
    "dev": "pnpm exec tsc --watch",
    "build": "./version.sh && pnpm run tsc && pnpm run format && pnpm run lint && pnpm run clean && pnpm run build:cjs && pnpm run build:esm && pnpm run build:types",
    "build:cjs": "pnpm exec esbuild src/index.ts --bundle --external:react --format=cjs --outfile=dist/schematic-react.cjs.js",
    "build:esm": "pnpm exec esbuild src/index.ts --bundle --external:react --format=esm --outfile=dist/schematic-react.esm.js",
    "build:types": "pnpm exec tsc && pnpm exec api-extractor run",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --fix",
    "test": "vitest run",
    "test:reactnative": "vitest run --config vitest.config.reactnative.ts",
    "test:watch": "vitest",
    "tsc": "pnpm exec tsc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@schematichq/schematic-js": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@vitest/browser": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
